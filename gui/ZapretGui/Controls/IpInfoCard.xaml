<!--
    «Как вас видят сайты» — фактический внешний адрес и то, что по нему читается.

    Карточка намеренно ничего не подменяет: обход DPI не меняет ни IP, ни страну,
    и нижнее пояснение говорит об этом прямо. Запрос уходит только по кнопке —
    он раскрывает адрес пользователя стороннему сервису.
-->
<UserControl x:Class="ZapretGui.Controls.IpInfoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource FontUI}"
             FontSize="{StaticResource FontSizeBody}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Подпись строки: 12.5 px, третичный. -->
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizePageSubtitle}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="RowValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <!-- Пояснение внизу: длинный текст, перенос по словам, без обрезки. -->
        <Style x:Key="NoteTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizePageSubtitle}" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

    </UserControl.Resources>

    <Border x:Name="Card" Style="{StaticResource CardStyle}" Padding="0">
        <Grid ClipToBounds="True">

            <!--
                Индикатор неопределённой длительности (§9): 2 px во всю ширину карточки.
                Ширина трека известна только после Arrange, поэтому раскадровка строится в коде.
            -->
            <Grid x:Name="ProgressTrack"
                  Height="2"
                  VerticalAlignment="Top"
                  ClipToBounds="True"
                  IsHitTestVisible="False"
                  Visibility="Collapsed">
                <Rectangle x:Name="ProgressChip"
                           Width="96"
                           HorizontalAlignment="Left"
                           Fill="{x:Null}">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ProgressShift" X="-96" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>

            <StackPanel Margin="20">

                <!-- ============ Шапка ============ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Как вас видят сайты" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   Text="Внешний адрес вашего подключения" />
                    </StackPanel>

                    <Button x:Name="CheckButton"
                            Grid.Column="2"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="120"
                            VerticalAlignment="Center"
                            Content="Проверить"
                            Click="OnCheckClick"
                            AutomationProperties.Name="Проверить внешний адрес" />
                </Grid>

                <!-- ============ Область состояния ============ -->
                <!-- Карточка живёт на «Диагностике» рядом со списком проверок: держим её компактной,
                     иначе список уезжает за нижний край. -->
                <Grid x:Name="ContentHost" Margin="0,12,0,0" MinHeight="104">

                    <!-- Пусто: проверка ещё не запускалась. -->
                    <StackPanel x:Name="EmptyState"
                                MaxWidth="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Path Width="28" Height="28"
                              Stretch="Uniform"
                              Data="{StaticResource IconGlobeStroke}"
                              Fill="{x:Null}"
                              Stroke="{StaticResource BrushTextDisabled}"
                              StrokeThickness="1.25"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" />

                        <TextBlock Margin="0,10,0,0"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeCardTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextAlignment="Center"
                                   Text="Проверка не выполнялась" />

                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource NoteTextStyle}"
                                   TextAlignment="Center"
                                   Text="Нажмите «Проверить» — запрос уйдёт на внешний сервис и покажет ваш IP" />
                    </StackPanel>

                    <!-- Идёт запрос. -->
                    <StackPanel x:Name="LoadingState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   TextAlignment="Center"
                                   Text="Спрашиваем внешний сервис, какой адрес он видит" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource NoteTextStyle}"
                                   TextAlignment="Center"
                                   Text="Обычно занимает пару секунд" />
                    </StackPanel>

                    <!-- Результат. -->
                    <StackPanel x:Name="ResultState" Visibility="Collapsed">

                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="IP-адрес" />

                            <TextBlock x:Name="IpValue"
                                       Grid.Column="1"
                                       Style="{StaticResource RowValueStyle}"
                                       FontFamily="{StaticResource FontMono}"
                                       Typography.NumeralAlignment="Tabular"
                                       Text="—" />

                            <Button x:Name="CopyButton"
                                    Grid.Column="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="OnCopyClick"
                                    ToolTip="Скопировать адрес"
                                    AutomationProperties.Name="Скопировать адрес">
                                <Path Style="{StaticResource IconSmallStyle}"
                                      Data="{StaticResource IconCopyStroke}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource SeparatorStyle}" />

                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Страна" />
                            <TextBlock x:Name="CountryValue" Grid.Column="1" Style="{StaticResource RowValueStyle}" Text="—" />
                        </Grid>

                        <Border Style="{StaticResource SeparatorStyle}" />

                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Город" />
                            <TextBlock x:Name="CityValue" Grid.Column="1" Style="{StaticResource RowValueStyle}" Text="—" />
                        </Grid>

                        <Border Style="{StaticResource SeparatorStyle}" />

                        <Grid Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Провайдер" />
                            <TextBlock x:Name="ProviderValue" Grid.Column="1" Style="{StaticResource RowValueStyle}" Text="—" />
                        </Grid>

                        <TextBlock x:Name="StampLabel"
                                   Margin="0,12,0,0"
                                   Style="{StaticResource MicroLabelStyle}"
                                   Text="" />
                    </StackPanel>

                    <!-- Ошибка сети: рамка карточки краснеет, содержимое подменяется (§9). -->
                    <StackPanel x:Name="ErrorState" VerticalAlignment="Center" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  Data="{StaticResource IconAlertStroke}"
                                  Fill="{x:Null}"
                                  Stroke="{StaticResource BrushDanger}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  VerticalAlignment="Top" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource CardTitleStyle}"
                                           Text="Не удалось проверить: нет соединения" />
                                <TextBlock x:Name="ErrorDetail"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource NoteTextStyle}"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           Text="Сервис не ответил за отведённое время. Проверьте интернет и попробуйте ещё раз." />
                            </StackPanel>
                        </Grid>

                        <Button x:Name="RetryButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="96" Height="28"
                                Margin="32,16,0,0"
                                HorizontalAlignment="Left"
                                Content="Повторить"
                                Click="OnCheckClick" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SeparatorStyle}" Margin="0,16,0,0" />

                <!-- ============ Честное пояснение ============ -->
                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource NoteTextStyle}"
                           Text="Обход DPI не меняет ни IP-адрес, ни страну: winws.exe правит только заголовки пакетов, а трафик по-прежнему идёт через вашего провайдера. Чтобы сайты видели другую страну, нужен VPN или прокси — они действительно ведут трафик через чужой сервер. Здесь показано ровно то, что видит сайт на той стороне." />

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
