<UserControl x:Class="ZapretGui.Controls.PowerDial"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZapretGui.Controls"
             Focusable="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- (j) Мишень. Единственный слой сборки, который вообще участвует в хит-тесте. -->
        <Style x:Key="DialHitTargetStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="230" Height="230">
                            <Ellipse Width="224" Height="224" Fill="Transparent" />
                            <Ellipse x:Name="FocusRing" Width="230" Height="230"
                                     Stroke="{StaticResource BrushFocusRing}"
                                     StrokeThickness="1"
                                     Fill="{x:Null}"
                                     Opacity="0"
                                     IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.09"
                                                             FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.09"
                                                             FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- (k) Подпись состояния: 13/SemiBold, прописными. -->
        <Style x:Key="DialCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center">

        <!--
            ============ Сборка 328×328: все слои концентричны по построению ============
            Размер сетки — по САМОМУ БОЛЬШОМУ слою, а не по мишени 224. Раньше сетка была 224,
            и WPF обрезал по слоту всё, что вылезало: свечение 300 превращалось в скруглённую
            плашку, крайние риски 240 подрезались, а радарный импульс (208×1.26 = 262) распадался
            на четыре куска по углам. Именно это и читалось как «обрезано».
            Запас до 328 держит раздувание свечения при LockPulse (300 × 1.04 = 312)
            и ударное кольцо при Ignite (208 × 1.55 = 322.4), включая сглаживание на краях.
        -->
        <Grid x:Name="DialGrid" Width="328" Height="328" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="DialScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="DialShake" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- (a) Амбиентная лужа. Свечение — это градиент, а не DropShadowEffect. -->
            <Ellipse x:Name="AmbientPool" Width="300" Height="300"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0" IsHitTestVisible="False"
                     RenderTransformOrigin="0.5,0.5"
                     CacheMode="BitmapCache">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="PoolScale" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop x:Name="PoolStopCore" Offset="0.0" Color="#5929C4FA" />
                        <GradientStop x:Name="PoolStopMid" Offset="0.55" Color="#1F29C4FA" />
                        <GradientStop x:Name="PoolStopEdge" Offset="1.0" Color="#0029C4FA" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- (b) Спокойный безель: 60 рисок — один GeometryDrawing, кисть задаётся кодом и заморожена. -->
            <Rectangle x:Name="IdleTicks" Width="240" Height="240"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" />

            <!-- (c) Зажжённый безель: та же геометрия акцентом, проявляется маской изнутри наружу. -->
            <Rectangle x:Name="LiveTicks" Width="240" Height="240"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush x:Name="TickMask"
                                         GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                         RadiusX="0" RadiusY="0">
                        <GradientStop Offset="0.0" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.85" Color="#FFFFFFFF" />
                        <GradientStop Offset="1.0" Color="#00FFFFFF" />
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <!-- (d) Дорожка кольца. -->
            <Ellipse Width="208" Height="208"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{StaticResource BrushHairlineStrong}" StrokeThickness="2"
                     Fill="{x:Null}" IsHitTestVisible="False" />

            <!-- (e) Дуга взвода. Кисть объявлена локально — её цвета анимируются при сбое. -->
            <local:ArcSegmentShape x:Name="SweepArc" Radius="104" Thickness="2" Angle="0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                   IsHitTestVisible="False">
                <local:ArcSegmentShape.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="SweepStopStart" Offset="0.0" Color="#FF26E0F2" />
                        <GradientStop x:Name="SweepStopMid" Offset="0.5" Color="#FF29C4FA" />
                        <GradientStop x:Name="SweepStopEnd" Offset="1.0" Color="#FF2FA8FF" />
                    </LinearGradientBrush>
                </local:ArcSegmentShape.Stroke>
            </local:ArcSegmentShape>

            <!--
                (f) Бегущий блик. Раньше это была отдельная дуга радиусом 98: она шла всего на 6 px
                внутри кольца, две линии сливались в одну «двойную» с резким срезом на конце.
                Теперь блик лежит РОВНО на кольце (тот же радиус 104) и читается как свет,
                бегущий по кольцу, а не как обрезанный кусок.
                Никаких Effect: вращение под эффектом растрируется каждый кадр.
            -->
            <local:ArcSegmentShape x:Name="ScannerArc" Radius="104" Thickness="3" Angle="76"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                   Opacity="0" IsHitTestVisible="False"
                                   RenderTransformOrigin="0.5,0.5">
                <local:ArcSegmentShape.RenderTransform>
                    <RotateTransform x:Name="ScannerRotate" Angle="0" />
                </local:ArcSegmentShape.RenderTransform>
                <local:ArcSegmentShape.Stroke>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                        <GradientStop x:Name="ScannerStopTail" Offset="0.0" Color="#0029C4FA" />
                        <GradientStop Offset="0.55" Color="#5529C4FA" />
                        <GradientStop x:Name="ScannerStopHead" Offset="1.0" Color="#FFFFFFFF" />
                    </LinearGradientBrush>
                </local:ArcSegmentShape.Stroke>
            </local:ArcSegmentShape>

            <!--
                (f2) Радарный импульс: кольцо раз в 2.6 с расходится наружу и гаснет.
                Это то «привлекающее» движение, которого не хватало — оно заметно
                на периферии зрения и при этом не мельтешит.
            -->
            <Ellipse x:Name="PingRing" Width="208" Height="208"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{DynamicResource BrushAccentMid}" StrokeThickness="1.5"
                     Fill="{x:Null}" Opacity="0" IsHitTestVisible="False"
                     CacheMode="BitmapCache"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="PingScale" ScaleX="1" ScaleY="1" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- (g) Лицо диска. -->
            <Ellipse x:Name="DialFace" Width="152" Height="152"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{StaticResource BrushHairlineStrong}" StrokeThickness="1"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop x:Name="FaceStopCore" Offset="0.0" Color="#FF141922" />
                        <GradientStop x:Name="FaceStopEdge" Offset="1.0" Color="#FF0C1017" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- (h) Глиф питания 46×46: дуга r=17 от 40° до 320° плюс ножка. -->
            <Path x:Name="Glyph" Width="46" Height="46"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M33.93,9.98 A17,17 0 1 1 12.07,9.98 M23,7 L23,22"
                  StrokeThickness="2.25"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Fill="{x:Null}" IsHitTestVisible="False">
                <Path.Stroke>
                    <SolidColorBrush x:Name="GlyphBrush" Color="#FF6E7A85" />
                </Path.Stroke>
            </Path>

            <!-- (i) Ударное кольцо: один выстрел на зажигание. -->
            <Ellipse x:Name="ShockRing" Width="208" Height="208"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="{DynamicResource BrushAccentStart}" StrokeThickness="2"
                     Fill="{x:Null}" Opacity="0" IsHitTestVisible="False"
                     RenderTransformOrigin="0.5,0.5"
                     CacheMode="BitmapCache">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="ShockScale" ScaleX="0.62" ScaleY="0.62" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- (j) -->
            <ToggleButton x:Name="HitTarget"
                          Style="{StaticResource DialHitTargetStyle}"
                          ToolTipService.ShowOnDisabled="True"
                          AutomationProperties.Name="Включить обход" />
        </Grid>

        <!-- ============ (k) Подписи под сборкой ============ -->
        <TextBlock x:Name="CaptionText" Style="{StaticResource DialCaptionStyle}"
                   Margin="0,20,0,0" Text="ОБХОД ВЫКЛЮЧЕН"
                   Foreground="{StaticResource BrushTextSecondary}" />

        <StackPanel x:Name="UptimeHost" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,0" />

        <TextBlock Style="{StaticResource MicroLabelStyle}"
                   HorizontalAlignment="Center" Margin="0,4,0,0"
                   Text="ВРЕМЯ РАБОТЫ" />

    </StackPanel>
</UserControl>
