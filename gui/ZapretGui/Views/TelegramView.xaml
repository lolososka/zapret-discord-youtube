<UserControl x:Class="ZapretGui.Views.TelegramView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="clr-namespace:ZapretGui.Controls"
             Background="{StaticResource BrushBgSunken}"
             FontFamily="{StaticResource FontUI}"
             FontSize="{StaticResource FontSizeBody}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <Style x:Key="GroupCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="fx:Fx.Reveal" Value="True" />
        </Style>

        <Style x:Key="ExplainTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PathTextStyle" TargetType="TextBlock" BasedOn="{StaticResource InlineNumericStyle}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="32" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        </Style>

        <Style x:Key="CopyButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <Grid MaxWidth="908" Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Шапка ============ -->
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Телеграм" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                           Text="Обход замедления через локальный прокси" />
            </StackPanel>

            <Button x:Name="RefreshButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="108" Height="32"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Content="Обновить"
                    ToolTip="Проверить, найден ли файл и работает ли прокси"
                    Click="OnRefreshClick" />
        </Grid>

        <!-- ============ Карточки ============ -->
        <ScrollViewer Grid.Row="2"
                      Style="{StaticResource ModernScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="VerticalOnly">
            <StackPanel Margin="0,0,10,0">

                <!-- ─────────── Зачем это нужно ─────────── -->
                <Border Style="{StaticResource GroupCardStyle}" fx:Fx.RevealIndex="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MicroLabelStyle}" Text="ЗАЧЕМ ЭТО НУЖНО" />

                        <TextBlock Style="{StaticResource ExplainTextStyle}"
                                   Text="Zapret правит сетевые пакеты на лету, но Telegram Desktop ходит к своим дата-центрам по протоколу MTProto на нестандартных портах — до этих соединений правки не доходят." />

                        <TextBlock Style="{StaticResource ExplainTextStyle}"
                                   Text="TgWsProxy — отдельная утилита Flowseal. Она поднимает локальный MTProto-прокси на 127.0.0.1:1443, перехватывает соединения к дата-центрам и заворачивает их в WebSocket." />

                        <TextBlock Style="{StaticResource ExplainTextStyle}"
                                   Text="В поставку она не входит. Скачайте файл сами и положите рядом с ZapretGUI.exe — оболочка найдёт его, запустит и подготовит ссылку для Telegram." />

                        <Button x:Name="ProjectLink"
                                Style="{StaticResource LinkButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Content="Открыть страницу проекта"
                                Click="OnDownloadClick" />
                    </StackPanel>
                </Border>

                <!-- ─────────── Состояние ─────────── -->
                <Border Style="{StaticResource GroupCardStyle}" fx:Fx.RevealIndex="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MicroLabelStyle}" Text="СОСТОЯНИЕ" />

                        <DockPanel Margin="0,12,0,0">
                            <Border x:Name="PidPill" DockPanel.Dock="Right"
                                    Style="{StaticResource StatusPillStyle}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="PidText" VerticalAlignment="Center" Text="PID —" />
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="8" Height="8"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource BrushTextDisabled}" />
                                <TextBlock x:Name="StateTitleText"
                                           Style="{StaticResource CardTitleStyle}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="TgWsProxy не найден" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock x:Name="PathText"
                                   Style="{StaticResource PathTextStyle}"
                                   Margin="0,8,0,0"
                                   Text="файл не найден" />

                        <!-- файл найден -->
                        <StackPanel x:Name="FoundPanel">
                            <Border Style="{StaticResource SeparatorStyle}" Margin="0,16,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="StartButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="132" Height="36"
                                        Content="Запустить"
                                        Click="OnStartClick" />
                                <Button x:Name="StopButton"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="132" Height="36" Margin="12,0,0,0"
                                        Content="Остановить"
                                        Click="OnStopClick" />
                                <Button x:Name="PickButton"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Height="36" Margin="12,0,0,0"
                                        Content="Указать файл…"
                                        ToolTip="Выбрать TgWsProxy вручную, если он лежит в другой папке"
                                        Click="OnPickClick" />
                                <Button x:Name="FolderButton"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Height="36" Margin="4,0,0,0"
                                        Content="Открыть папку"
                                        Click="OnFolderClick" />
                            </StackPanel>
                        </StackPanel>

                        <!-- файла нет -->
                        <StackPanel x:Name="MissingPanel" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,12,0,0"
                                       Text="Со страницы релизов нужен файл TgWsProxy_windows.exe (для Windows 7 — вариант с _7_ в имени, для ARM — arm64). Положите его в папку:" />

                            <TextBlock x:Name="SuggestedFolderText"
                                       Style="{StaticResource PathTextStyle}"
                                       Margin="0,6,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="DownloadButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="188" Height="36"
                                        Content="Скачать TgWsProxy"
                                        Click="OnDownloadClick" />
                                <Button x:Name="PickButtonMissing"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="148" Height="36" Margin="12,0,0,0"
                                        Content="Указать файл…"
                                        Click="OnPickClick" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ─────────── Настройка Telegram ─────────── -->
                <Border Style="{StaticResource GroupCardStyle}" fx:Fx.RevealIndex="2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MicroLabelStyle}" Text="НАСТРОЙКА TELEGRAM" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" Text="Сервер" />
                            <TextBox x:Name="HostBox" Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource ReadOnlyFieldStyle}"
                                     Text="127.0.0.1" />
                            <Button x:Name="CopyHostButton" Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource CopyButtonStyle}"
                                    Tag="host"
                                    ToolTip="Скопировать адрес"
                                    Click="OnCopyClick">
                                <Path Style="{StaticResource IconSmallStyle}"
                                      Data="{StaticResource IconCopyStroke}" />
                            </Button>

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" Text="Порт" />
                            <TextBox x:Name="PortBox" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource ReadOnlyFieldStyle}"
                                     Text="1443" />
                            <Button x:Name="CopyPortButton" Grid.Row="2" Grid.Column="2"
                                    Style="{StaticResource CopyButtonStyle}"
                                    Tag="port"
                                    ToolTip="Скопировать порт"
                                    Click="OnCopyClick">
                                <Path Style="{StaticResource IconSmallStyle}"
                                      Data="{StaticResource IconCopyStroke}" />
                            </Button>
                        </Grid>

                        <TextBlock Style="{StaticResource MicroLabelStyle}" Margin="0,20,0,0" Text="СЕКРЕТ" />

                        <TextBox x:Name="SecretBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,8,0,0"
                                 Height="32"
                                 FontFamily="{StaticResource FontMono}"
                                 Tag="вставьте секрет из окна TgWsProxy"
                                 TextChanged="OnSecretTextChanged"
                                 LostFocus="OnSecretLostFocus"
                                 KeyDown="OnSecretKeyDown" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0"
                                   Text="TgWsProxy показывает секрет в своём окне. Можно вставить и целую ссылку tg://proxy — из неё возьмётся только секрет. Значение сохраняется, вводить его нужно один раз." />

                        <Button x:Name="ConfigureButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="188" Height="36"
                                HorizontalAlignment="Left"
                                Margin="0,16,0,0"
                                IsEnabled="False"
                                Content="Настроить Telegram"
                                ToolTip="Откроет Telegram и предложит добавить прокси"
                                Click="OnConfigureClick" />

                        <Border Style="{StaticResource SeparatorStyle}" Margin="0,18,0,0" />

                        <TextBlock Style="{StaticResource MicroLabelStyle}" Margin="0,16,0,0" Text="ВРУЧНУЮ" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0"
                                   Text="Telegram → Настройки → Продвинутые настройки → Тип соединения → Использовать собственный прокси → Добавить прокси → MTProto. Сервер 127.0.0.1, порт 1443, секрет из окна TgWsProxy." />
                    </StackPanel>
                </Border>

                <!-- ─────────── Запуск ─────────── -->
                <Border Style="{StaticResource GroupCardStyle}" fx:Fx.RevealIndex="3" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MicroLabelStyle}" Text="ЗАПУСК" />

                        <DockPanel Height="44" Margin="0,6,0,0" LastChildFill="True">
                            <ToggleButton x:Name="AutoStartSwitch" DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Checked="OnAutoStartToggled"
                                          Unchecked="OnAutoStartToggled" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       Text="Запускать вместе с обходом" />
                        </DockPanel>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,4,0,0"
                                   Text="Прокси поднимется сразу после включения обхода DPI. Он живёт в трее и продолжает работать после закрытия оболочки — останавливать его нужно кнопкой «Остановить»." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
