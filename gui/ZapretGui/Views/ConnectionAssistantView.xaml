<UserControl x:Class="ZapretGui.Views.ConnectionAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="clr-namespace:ZapretGui.Controls"
             Background="{StaticResource BrushBgSunken}"
             FontFamily="{StaticResource FontUI}" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="ServiceRow">
            <Border Padding="0,18" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushHairlineWeak}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BrushWarning}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasResult}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource BrushTextDisabled}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0" ToolTip="{Binding Detail}">
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="{Binding Name}"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"
                                   Text="{Binding StatusText}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Style="{StaticResource InlineNumericStyle}" Margin="0,2,0,0"
                               Text="{Binding LatencyText}" Foreground="{StaticResource BrushTextSecondary}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="1120">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Мастер сети"/>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,6,0,0"
                               Text="{Binding Assistant.NetworkName}" ToolTip="{Binding Assistant.NetworkName}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Обновить сеть" Height="32" VerticalAlignment="Center"
                        Style="{StaticResource GhostButtonStyle}" Command="{Binding Assistant.RefreshNetworkCommand}"/>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,24,0,0" fx:Fx.Reveal="True" fx:Fx.RevealIndex="0">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,18">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Assistant.IsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <TextBlock Style="{StaticResource MicroLabelStyle}" Text="ЧТО ПРОВЕРЯЕМ" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <RadioButton Style="{StaticResource ChipToggleStyle}" Content="Все" GroupName="AssistantGoal"
                                     IsChecked="{Binding Assistant.GoalAll, Mode=OneWay}" Tag="All" Click="OnGoalClick" Margin="0,0,8,0"/>
                        <RadioButton Style="{StaticResource ChipToggleStyle}" Content="YouTube" GroupName="AssistantGoal"
                                     IsChecked="{Binding Assistant.GoalYouTube, Mode=OneWay}" Tag="YouTube" Click="OnGoalClick" Margin="0,0,8,0"/>
                        <RadioButton Style="{StaticResource ChipToggleStyle}" Content="Discord" GroupName="AssistantGoal"
                                     IsChecked="{Binding Assistant.GoalDiscord, Mode=OneWay}" Tag="Discord" Click="OnGoalClick"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Assistant.StatusText}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Assistant.StepText}" Margin="0,8,0,0"
                               Foreground="{StaticResource BrushTextTertiary}"/>
                    <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Margin="0,16,0,0" Minimum="0" Maximum="1"
                                 Value="{Binding Assistant.Progress, Mode=OneWay}"
                                 Visibility="{Binding Assistant.IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <WrapPanel Margin="0,20,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Сравнить соединение"
                                Command="{Binding Assistant.CheckCommand}" Margin="0,0,10,8"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Подобрать стратегию"
                                Command="{Binding Assistant.PickCommand}" Margin="0,0,10,8"/>
                        <Button Style="{StaticResource GhostButtonStyle}" Content="Отмена" Margin="0,0,0,8"
                                Command="{Binding Assistant.CancelCommand}"
                                Visibility="{Binding Assistant.CanCancel, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Проверка временно перезапускает обход."
                               Foreground="{StaticResource BrushTextTertiary}"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0" fx:Fx.Reveal="True" fx:Fx.RevealIndex="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MicroLabelStyle}" Text="БЕЗ ОБХОДА"/>
                        <ItemsControl ItemsSource="{Binding Assistant.BaselineServices}" ItemTemplate="{StaticResource ServiceRow}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="{DynamicResource BrushAccentDim}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MicroLabelStyle}" Text="СО СТРАТЕГИЕЙ" Foreground="{DynamicResource BrushAccentMid}"/>
                        <ItemsControl ItemsSource="{Binding Assistant.CurrentServices}" ItemTemplate="{StaticResource ServiceRow}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextTertiary}" Text="HTTP-доступность · видео и голос проверяются отдельно"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0"
                    Visibility="{Binding Assistant.HasRecommendation, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MicroLabelStyle}" Text="РЕЗУЛЬТАТ ПОДБОРА"/>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Assistant.RecommendedTitle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Style="{StaticResource InlineNumericStyle}" Text="{Binding Assistant.RecommendedScore}" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Запустить стратегию"
                                Command="{Binding Assistant.ApplyCommand}" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0" fx:Fx.Reveal="True" fx:Fx.RevealIndex="2">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Профили этой сети"/>
                    <WrapPanel Margin="0,16,0,0">
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Width="220" Height="36" MaxLength="64"
                                 Text="{Binding Assistant.ProfileNameText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,8"
                                 AutomationProperties.Name="Название нового профиля"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Сохранить результат"
                                Command="{Binding Assistant.SaveProfileCommand}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <Border BorderBrush="{StaticResource BrushHairlineWeak}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,16,0,0">
                        <WrapPanel>
                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" Width="220" Height="36" Margin="0,0,10,8"
                                      ItemsSource="{Binding Assistant.Profiles}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding Assistant.SelectedProfile}" AutomationProperties.Name="Сохранённый профиль"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Запустить профиль"
                                    Command="{Binding Assistant.ApplyProfileCommand}" Margin="0,0,10,8"/>
                            <Button Style="{StaticResource GhostButtonStyle}" Content="Удалить"
                                    Command="{Binding Assistant.RemoveProfileCommand}" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
