                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Underline"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
