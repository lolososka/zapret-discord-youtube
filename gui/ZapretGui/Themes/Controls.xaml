<!--
    Контролы (§4, §5, §7 спецификации).

    Правила, которым здесь подчинено всё:
    • Неявные стили только у ScrollBar и ToolTip. Всё остальное — с x:Key.
    • Анимируются только локальные (объявленные внутри ControlTemplate) кисти и трансформы.
      Кисть из StaticResource заморожена — ColorAnimation по ней падает в рантайме.
    • Смена фона на hover/press сделана наложенным слоем с анимацией Opacity: это буквально
      тот же альфа-переход #00161B23 → #FF161B23 из §7, но без анимации общих кистей
      и без потери DynamicResource-акцента.
    • Раскадровки в триггерах шаблонов удерживают конечное значение (HoldEnd) и снимаются
      парным ExitActions — XAML-эквивалент «FillBehavior=Stop + фиксация в Completed».
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- ==================================================================
         Поверхности
         ================================================================== -->

    <!-- E1: крупная панель / группа настроек. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushHairlineWeak}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius8}" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!--
        Кликабельная карточка. Подъём на −2 px и наложение BrushCardHoverOverlay из CardHoverLift
        живут в дереве страницы: Border не имеет шаблона, а Freezable в Setter-е запечатывается
        и анимации по нему запрещены. Здесь — только смена рамки и курсор.
    -->
    <Style x:Key="CardInteractiveStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushHairlineStrong}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- E1: метрическая плитка. -->
    <Style x:Key="TileStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushHairlineWeak}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius8}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Горизонтальная волосяная линия в 1 DIP. -->
    <Style x:Key="SeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource BrushHairlineWeak}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Тег-чип «ALT» / «игры»: цвет задаётся потребителем через BorderBrush + TextElement.Foreground. -->
    <Style x:Key="TagChipStyle" TargetType="Border">
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius4}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushHairlineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource FontBrand}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="TextElement.FontWeight" Value="Normal" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextTertiary}" />
    </Style>

    <!-- Пилюля состояния в титульной строке и в шапках карточек. -->
    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="Background" Value="{StaticResource BrushSurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushHairlineWeak}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource FontBrand}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="TextElement.FontWeight" Value="Normal" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>

    <!-- ==================================================================
         Иконки (Path из Themes/Icons.xaml)
         ================================================================== -->

    <Style x:Key="IconStyle" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconSmallStyle" TargetType="Path" BasedOn="{StaticResource IconStyle}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>

    <!-- ==================================================================
         Кнопки
         ================================================================== -->

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource BrushAccentGradient}" />
        <Setter Property="Foreground" Value="#FF05070A" />
        <Setter Property="FontFamily" Value="{StaticResource FontBrand}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Squeeze" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="FocusRing" Margin="-3"
                                CornerRadius="{StaticResource Radius8}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BrushFocusRing}"
                                Opacity="0" />

                        <Border x:Name="Fill"
                                CornerRadius="{StaticResource Radius6}"
                                Background="{TemplateBinding Background}" />

                        <!-- Осветление на hover: белый слой в 7 %. -->
                        <Border x:Name="Sheen"
                                CornerRadius="{StaticResource Radius6}"
                                Background="#FFFFFFFF"
                                Opacity="0" />

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sheen"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.07" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sheen"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- ButtonPress: 1.000 → 0.976 за 70 мс, возврат за 120 мс, без овершута. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.976" Duration="{StaticResource DurPress}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.976" Duration="{StaticResource DurPress}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- FocusRingFade: 90 мс, Linear, только Opacity. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource BrushDisabledSurface}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBrand}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Squeeze" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="FocusRing" Margin="-3"
                                CornerRadius="{StaticResource Radius8}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BrushFocusRing}"
                                Opacity="0" />

                        <Border x:Name="Fill"
                                CornerRadius="{StaticResource Radius6}"
                                Background="{StaticResource BrushSurfaceRaised}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BrushHairlineStrong}" />

                        <Border x:Name="Hover"
                                CornerRadius="{StaticResource Radius6}"
                                Background="{StaticResource BrushSurfaceHover}"
                                Opacity="0" />

                        <Border x:Name="Press"
                                CornerRadius="{StaticResource Radius6}"
                                Background="{StaticResource BrushSurfacePressed}"
                                Opacity="0" />

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{StaticResource BrushHairlineStrong}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.976" Duration="{StaticResource DurPress}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.976" Duration="{StaticResource DurPress}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource BrushDisabledSurface}" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{StaticResource BrushHairlineWeak}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBrand}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Squeeze" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="FocusRing" Margin="-3"
                                CornerRadius="{StaticResource Radius8}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BrushFocusRing}"
                                Opacity="0" />

                        <Border x:Name="Hover"
                                CornerRadius="{StaticResource Radius6}"
                                Background="{StaticResource BrushSurfaceHover}"
                                Opacity="0" />

                        <Border x:Name="Press"
                                CornerRadius="{StaticResource Radius6}"
                                Background="{StaticResource BrushSurfacePressed}"
                                Opacity="0" />

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.976" Duration="{StaticResource DurPress}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.976" Duration="{StaticResource DurPress}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- «Удалить службу»: 1px BrushDanger, текст BrushDanger, hover-заливка BrushDanger @ 0.12. -->
    <Style x:Key="DangerOutlineButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
        <Setter Property="FontFamily" Value="{StaticResource FontBrand}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Squeeze" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="FocusRing" Margin="-3"
                                CornerRadius="{StaticResource Radius8}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BrushFocusRing}"
                                Opacity="0" />

                        <Border x:Name="Wash"
                                CornerRadius="{StaticResource Radius6}"
                                Background="{StaticResource BrushDanger}"
                                Opacity="0" />

                        <Border x:Name="Frame"
                                CornerRadius="{StaticResource Radius6}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BrushDanger}"
                                Background="Transparent" />

                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Wash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.12" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Wash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.2" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.976" Duration="{StaticResource DurPress}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.976" Duration="{StaticResource DurPress}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource BrushHairlineWeak}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Квадратная кнопка-иконка 28×28: содержимое — Path со стилем IconSmallStyle. -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Squeeze" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Border x:Name="FocusRing" Margin="-3"
                                CornerRadius="{StaticResource Radius8}"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BrushFocusRing}"
                                Opacity="0" />

                        <Border x:Name="Hover"
                                CornerRadius="{StaticResource Radius6}"
                                Background="{StaticResource BrushSurfaceHover}"
                                Opacity="0" />

                        <Border x:Name="Press"
                                CornerRadius="{StaticResource Radius6}"
                                Background="{StaticResource BrushSurfacePressed}"
                                Opacity="0" />

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.11"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Hover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Press" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.976" Duration="{StaticResource DurPress}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.976" Duration="{StaticResource DurPress}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                        <DoubleAnimation Storyboard.TargetName="Squeeze"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource DurFast}"
                                                         EasingFunction="{StaticResource EaseOutQuad}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.09" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Текстовая ссылка: подчёркивание появляется на hover, акцент — DynamicResource. -->
    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
